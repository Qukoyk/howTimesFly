# Times Gate 设备 IP（必填）
DEVICE_IP=192.168.3.96

# 云端五屏配置查询（GET /screens）用的 DeviceId（必填，否则该端点报错提示）
# 自己设备的 id：向设备发任意一条 LAN 命令，响应 JSON 里自带 DeviceId 字段
DEVICE_ID=

# GLM Coding Plan 额度查询（第 5 块屏用；不填 token 则显示占位文字）
# token 就是你配置 Claude Code / ZCode 时用的 ANTHROPIC_AUTH_TOKEN
# base 写根地址或带 /api/anthropic 的完整端点都行，代码只取域名部分（与官方插件一致）
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=
